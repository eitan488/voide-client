{
  "schemaVersion": 1,
  "id": "voidclient",
  "version": "${version}",
  "name": "Void Client",
  "description": "Premium futuristic client for Minecraft Java 1.21.11: animated neon GUI, HUD editor, visual engine, base inspection tools and Crystal/Anchor PvP training.",
  "authors": ["Void Client"],
  "license": "All-Rights-Reserved",
  "icon": "assets/voidclient/textures/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["voidclient.VoidClient"]
  },
  "mixins": ["voidclient.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
